{
  "name": "js",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "debug": "npm run start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "eslint . && esbuild src/index.ts --bundle --platform=node --packages=external --sourcemap --outdir=dist",
    "start": "node --trace-deprecation dist/index.js",
    "dev:node": "node --trace-deprecation --watch dist/index.js | pino-pretty",
    "dev:tsc": "tsc --watch",
    "dev:esbuild": "eslint . && esbuild --watch=forever src/index.ts --bundle --platform=node --packages=external --sourcemap --outdir=dist",
    "docker:dev": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up --watch",
    "docker:rebuild": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up --build --watch",
    "docker:prod": "docker compose -f docker-compose.yaml -f docker-compose.prod.yaml up -d",
    "local": "npm-run-all --parallel local:node dev:tsc dev:esbuild",
    "local:node": "node --trace-deprecation --watch --env-file=.env.development dist/index.js | pino-pretty",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint .",
      "prettier --check",
      "prettier 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.15.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.1",
    "eslint-plugin-perfectionist": "^4.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.1.2",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.879.0",
    "@aws-sdk/client-ec2": "^3.880.0",
    "@aws-sdk/credential-providers": "^3.907.0",
    "@google-cloud/compute": "^6.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/instrumentation-pino": "^0.55.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "node-gyp-build": "^4.8.4",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "pino-opentelemetry-transport": "^1.1.0",
    "zod": "^4.0.5"
  }
}
